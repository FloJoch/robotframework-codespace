{
    "name": "RF TodoMVC Demo",
    "image": "mcr.microsoft.com/devcontainers/python:3.13",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "password": "vscode"
        },
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "hostRequirements": {
        "cpus": 4
    },
    "runArgs": [
        "--shm-size=1g"
    ],
    "containerEnv": {
        "UV_LINK_MODE": "copy",
        "UV_PROJECT_ENVIRONMENT": ".venv",
        "DISPLAY": ":1"
    },
    "forwardPorts": [
        6080
    ],
    "portsAttributes": {
        "6080": {
            "label": "Desktop (noVNC)",
            "onAutoForward": "silent"
        }
    },
    "postCreateCommand": "python -m pip install --user uv && python -m uv sync && python -m uv run rfbrowser init chromium --with-deps",
    "postStartCommand": "python -m uv sync",
    "customizations": {
        "vscode": {
            "extensions": [
                "d-biehl.robotcode",
                "ms-python.python",
                "makrocode.rfEssentials",
                "anthropic.claude-code"
            ],
            "settings": {
                "python.terminal.activateEnvironment": true,
                "robotcode.robot.args": [
                    "--outputdir",
                    "results"
                ]
            }
        }
    }
}
